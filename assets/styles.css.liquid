/* State-of-the-Art Plum & Rose Gold Luxury Styling System */

:root {
    --color-primary: #FAF6F0;          /* Warm Champagne Ivory */
    --color-secondary: #2E1A22;        /* Deep Royal Plum */
    --color-bg-dark: #F4EBE8;          /* Dusty Rose Sage / Soft Mauve Sand */
    --color-bg-card: #ffffff;          /* Pure White for Card Panels */
    --color-accent: #D5A79E;           /* Rose Gold Accent */
    --color-accent-hover: #B98379;     /* Rich Rose Gold Bronze on Hover */
    --color-text-light: #2A1D22;       /* Deep Espresso Plum for Primary Text */
    --color-text-muted: #7B6B70;       /* Soft Mauve Gray */
    --color-border-thin: rgba(46, 26, 34, 0.12); /* Translucent plum border */
    --color-border-medium: rgba(46, 26, 34, 0.25);
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Inter', sans-serif;
    
    --transition-luxury: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    --transition-standard: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

ul, li {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0;
    margin: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--color-primary);
}

body {
    font-family: var(--font-body);
    background-color: var(--color-primary);
    color: var(--color-text-light);
    line-height: 1.65;
    letter-spacing: -0.01em;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
}

@media (max-width: 991px) {
    .container {
        padding: 0 30px;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 20px;
    }
}

a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition-standard);
}

button {
    font-family: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-secondary);
}

.text-center {
    text-align: center;
}

/* Elite Buttons */
.btn {
    display: inline-block;
    padding: 16px 40px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    cursor: pointer;
    position: relative;
    z-index: 1;
    overflow: hidden;
    transition: var(--transition-luxury);
    border-radius: 0;
}

.btn-gold {
    background: linear-gradient(135deg, #f5dcd6 0%, #D5A79E 50%, #b27c72 100%);
    color: var(--color-primary);
    border: 1px solid rgba(213, 167, 158, 0.8);
    font-weight: 600;
    box-shadow: 0 4px 20px rgba(213, 167, 158, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: var(--transition-standard);
}

.btn-gold:hover {
    color: var(--color-primary) !important;
    border-color: #f5dcd6;
    box-shadow: 0 8px 30px rgba(213, 167, 158, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
}

.btn-outline {
    background-color: transparent;
    color: var(--color-secondary);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-outline:hover {
    color: var(--color-primary);
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
}

#main-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition-luxury);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

#main-header.header-transparent {
    background-color: transparent;
}

#main-header.header-scrolled {
    background-color: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-bottom: 1px solid rgba(180, 151, 112, 0.15);
    box-shadow: 0 10px 35px rgba(180, 151, 112, 0.05);
}

#main-header.header-scrolled .logo-text,
#main-header.header-scrolled .nav-link,
#main-header.header-scrolled .utility-btn {
    color: var(--color-secondary);
}

#main-header.header-scrolled .nav-link::after {
    background-color: var(--color-accent);
}

.header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100px;
    padding: 0 60px;
    max-width: 1600px;
    margin: 0 auto;
    transition: var(--transition-luxury);
}

@media (max-width: 1024px) {
    .header-container {
        padding: 0 30px;
        height: 80px;
    }
}

.desktop-nav {
    flex: 1;
}

.desktop-nav.nav-left ul {
    display: flex;
    justify-content: flex-start;
    gap: 40px;
}

.desktop-nav.nav-right ul {
    display: flex;
    justify-content: flex-end;
    gap: 40px;
}

.nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    padding: 8px 0;
    position: relative;
    opacity: 0.85;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: var(--transition-standard);
    transform: translateX(-50%);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.nav-link:hover {
    opacity: 1;
}

.logo-container {
    text-align: center;
}

.logo-text {
    font-family: 'Bodoni Moda', serif;
    font-size: 2.2rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.38em;
    color: #ffffff;
    display: inline-block;
    padding-left: 0.38em; /* Offset letter-spacing centering issue */
    transition: var(--transition-luxury);
}

.logo-text:hover {
    color: var(--color-accent) !important;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
}

.header-utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
    flex: 1;
}

.utility-btn {
    font-size: 1.1rem;
    color: #ffffff;
    transition: var(--transition-standard);
    position: relative;
    opacity: 0.85;
}

.utility-btn:hover {
    color: var(--color-accent) !important;
    transform: translateY(-2px);
    opacity: 1;
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.6rem;
    font-weight: 600;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mobile-nav-toggle {
    display: none;
    font-size: 1.3rem;
    color: var(--color-secondary);
}

@media (max-width: 1024px) {
    .desktop-nav {
        display: none;
    }
    .mobile-nav-toggle {
        display: block;
        flex: 1;
        text-align: left;
    }
    .logo-container {
        flex: 2;
    }
    .logo-text {
        font-size: 1.8rem;
    }
}

@media (max-width: 768px) {
    .logo-text {
        font-size: 1.35rem !important;
        letter-spacing: 0.12em !important;
        padding-left: 0.12em !important;
    }
    .header-container {
        padding: 0 20px !important;
        height: 75px !important;
    }
    .header-utilities {
        gap: 15px !important;
    }
}

@media (max-width: 375px) {
    .logo-text {
        font-size: 1.1rem !important;
        letter-spacing: 0.06em !important;
        padding-left: 0.06em !important;
    }
}

/* Obsidian Drawers */
.mobile-drawer, .cart-drawer {
    position: fixed;
    top: 0;
    height: 100%;
    width: 480px;
    max-width: 100%;
    background-color: rgba(250, 248, 245, 0.96);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-left: 1px solid var(--color-border-thin);
    z-index: 2000;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.08);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
}

.mobile-drawer {
    border-left: none;
    border-right: 1px solid var(--color-border-thin);
}

.drawer-header {
    padding: 35px 50px;
    border-bottom: 1px solid var(--color-border-thin);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.drawer-title {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--color-secondary);
}

.drawer-close {
    font-size: 2.2rem;
    font-weight: 200;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.drawer-close:hover {
    color: var(--color-accent);
}

/* Mobile Menu Left Drawer */
.mobile-drawer {
    left: 0;
    transform: translateX(-100%);
}

.mobile-drawer.open {
    transform: translateX(0);
}

.mobile-menu-links {
    padding: 30px;
}

.mobile-menu-links li {
    margin-bottom: 0;
}

.mobile-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    display: block;
    color: var(--color-text-light);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 20px 0;
    transition: var(--transition-standard);
}

.mobile-link:hover {
    color: var(--color-accent);
    padding-left: 10px;
    border-bottom-color: var(--color-accent);
}

/* Cart Drawer (Right) */
.cart-drawer {
    right: 0;
    transform: translateX(100%);
}

.cart-drawer.open {
    transform: translateX(0);
}

.cart-drawer-overlay, .mobile-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.cart-drawer-overlay.open, .mobile-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
}

.cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 50px;
}

.empty-cart-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
}

.empty-icon {
    font-size: 2.5rem;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.empty-cart-state p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 35px;
}

.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 35px;
}

.cart-item {
    display: flex;
    gap: 25px;
    align-items: flex-start;
    border-bottom: 1px solid var(--color-border-thin);
    padding-bottom: 30px;
}

.cart-item-img {
    width: 100px;
    height: 135px;
    object-fit: cover;
}

.cart-item-details {
    flex: 1;
}

.cart-item-details h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 6px;
    color: var(--color-secondary);
}

.cart-item-variant {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.cart-item-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

.cart-item-qty {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 15px;
}

.qty-btn {
    border: 1px solid var(--color-border-thin);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.qty-btn:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-primary);
}

.qty-val {
    font-size: 0.85rem;
    font-weight: 500;
}

.cart-item-remove {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    margin-top: 15px;
    display: inline-block;
    transition: var(--transition-standard);
}

.cart-item-remove:hover {
    color: #ff3b30;
}

.cart-footer {
    padding: 35px 50px;
    border-top: 1px solid var(--color-border-thin);
    background-color: #0d0d0d;
}

.cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 12px;
}

.subtotal-amount {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-weight: 600;
}

.shipping-tax-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 30px;
}

/* Fullscreen Minimal Search Overlay (Dark) */
.search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 5, 5, 0.99);
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.search-overlay.open {
    opacity: 1;
    visibility: visible;
}

.search-close {
    position: absolute;
    top: 50px;
    right: 60px;
    font-size: 3rem;
    font-weight: 200;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.search-close:hover {
    color: var(--color-accent);
}

.search-overlay-content {
    width: 100%;
    max-width: 900px;
    padding: 0 60px;
    text-align: center;
}

.search-heading {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--color-secondary);
    margin-bottom: 40px;
}

.search-form {
    position: relative;
    border-bottom: 1.5px solid var(--color-accent);
    display: flex;
    align-items: center;
    padding-bottom: 15px;
}

.search-input {
    width: 100%;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-secondary);
    padding-right: 60px;
}

.search-submit-btn {
    font-size: 1.8rem;
    color: var(--color-accent);
    transition: var(--transition-standard);
}

.search-submit-btn:hover {
    transform: translateX(10px);
    color: var(--color-secondary);
}

.search-suggestions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.suggestion-tag {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-thin);
    padding: 10px 24px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.suggestion-tag:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-primary);
}

/* Premium Hero Section */
.hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-align: center;
    overflow: hidden;
}

.hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    animation: zoomOut 24s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.65) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    padding: 0 40px;
    margin-top: 60px;
}

.hero-subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 25px;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-title {
    font-size: 5.5rem;
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 30px;
    text-shadow: 0 10px 40px rgba(0,0,0,0.4);
    animation: fadeInUp 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-description {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 50px;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-actions {
    display: flex;
    justify-content: center;
    gap: 25px;
    animation: fadeInUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@media (max-width: 768px) {
    .hero-title {
        font-size: clamp(2rem, 8vw, 3.8rem);
    }
    .hero-description {
        font-size: 1rem;
        padding: 0 10px;
    }
    .hero-actions {
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }
    .hero-actions .btn {
        width: 100%;
        max-width: 320px;
    }
}

.scroll-indicator {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.scroll-text {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
}

.scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 100%);
    animation: pulseScroll 2.2s infinite;
}

@keyframes zoomOut {
    0% { transform: scale(1.08); }
    100% { transform: scale(1.01); }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulseScroll {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
}

/* Luxury Brand Pitch */
.brand-pitch {
    padding: 140px 0;
    background-color: var(--color-bg-dark);
    border-bottom: 1px solid var(--color-border-thin);
}

.section-title-alt {
    font-size: 2.6rem;
    margin-bottom: 80px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.pitch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 70px;
}

@media (max-width: 991px) {
    .pitch-grid {
        grid-template-columns: 1fr;
        gap: 50px;
    }
}

.pitch-card {
    padding: 0 10px;
}

.pitch-icon {
    font-size: 2.2rem;
    color: var(--color-accent);
    margin-bottom: 30px;
}

.pitch-card h3 {
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    font-weight: 500;
}

.pitch-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.8;
}

/* Elegant Collections Grid */
.collections-section {
    padding: 140px 0;
    background-color: var(--color-primary);
}

.section-title {
    font-size: 2.6rem;
    margin-bottom: 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
}

@media (max-width: 991px) {
    .collections-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    
    .collection-card {
        height: 380px;
    }
}

.collection-card {
    position: relative;
    height: 600px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    transition: var(--transition-luxury);
}

.collection-card:hover {
    border-color: rgba(197, 168, 128, 0.35);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
}

.collection-img-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: 0.8;
    transition: var(--transition-luxury);
    position: relative;
}

.collection-img-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.25) 50%, 
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    transition: 0.75s;
    z-index: 5;
}

.collection-card:hover .collection-img-wrapper::after {
    left: 150%;
}

.collection-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.collection-card:hover .collection-img {
    transform: scale(1.08);
}

.collection-card:hover .collection-img-wrapper {
    opacity: 0.55;
    filter: grayscale(20%);
}

.collection-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 50px;
    background: linear-gradient(360deg, rgba(5,5,5,0.9) 0%, rgba(5,5,5,0) 100%);
    color: var(--color-secondary);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 10;
}

.collection-content h3 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    font-weight: 300;
    letter-spacing: 0.02em;
}

.collection-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-accent);
}

.collection-link i {
    margin-left: 8px;
    transition: var(--transition-standard);
}

.collection-card:hover .collection-link i {
    transform: translateX(8px);
}

/* Premium Products Grid (High Fashion Layout) */
.products-section {
    padding: 140px 0;
    background-color: var(--color-bg-dark);
    border-top: 1px solid var(--color-border-thin);
    border-bottom: 1px solid var(--color-border-thin);
}

.section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 70px;
}

@media (max-width: 768px) {
    .section-header-flex {
        flex-direction: column;
        align-items: flex-start;
        gap: 30px;
    }
}

.product-filters {
    display: flex;
    gap: 40px;
}

.filter-tab {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
