/* State-of-the-Art Luxury Styling System (Inspired by High-End Haute Couture Stores) */

:root {
    --color-primary: #070707;          /* Obsidian Black */
    --color-secondary: #ffffff;        /* Pure White */
    --color-accent: #c5a880;           /* Luxury Muted Champagne Gold */
    --color-accent-hover: #a88d65;     /* Deeper Antique Gold */
    --color-bg-cream: #fbf9f6;         /* Sophisticated Warm Alabaster */
    --color-text-dark: #121212;        /* Rich Ink Black */
    --color-text-muted: #767677;       /* Refined Slate Gray */
    --color-border-thin: rgba(0, 0, 0, 0.06); /* Ultra-fine line */
    --color-border-light: rgba(255, 255, 255, 0.08);
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Inter', sans-serif;
    
    --transition-luxury: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    --transition-standard: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--color-bg-cream);
}

body {
    font-family: var(--font-body);
    color: var(--color-text-dark);
    line-height: 1.65;
    letter-spacing: -0.01em;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
}

@media (max-width: 991px) {
    .container {
        padding: 0 30px;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 20px;
    }
}

a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition-standard);
}

button {
    font-family: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
}

/* Typography Typography */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
}

.text-center {
    text-align: center;
}

/* Elite Buttons */
.btn {
    display: inline-block;
    padding: 16px 40px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    cursor: pointer;
    position: relative;
    z-index: 1;
    overflow: hidden;
    transition: var(--transition-luxury);
    border-radius: 0;
}

.btn-gold {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    border: 1px solid var(--color-primary);
}

.btn-gold::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-accent);
    z-index: -1;
    transform: translateY(100%);
    transition: var(--transition-luxury);
}

.btn-gold:hover {
    color: var(--color-primary);
    border-color: var(--color-accent);
}

.btn-gold:hover::before {
    transform: translateY(0);
}

.btn-outline {
    background-color: transparent;
    color: var(--color-secondary);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-outline:hover {
    color: var(--color-primary);
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
}

/* Header & Glassmorphism Navigation */
#main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition-luxury);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

#main-header.header-transparent {
    background-color: transparent;
}

#main-header.header-scrolled {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-bottom: 1px solid var(--color-border-thin);
}

#main-header.header-scrolled .logo-text,
#main-header.header-scrolled .nav-link,
#main-header.header-scrolled .utility-btn {
    color: var(--color-primary);
}

#main-header.header-scrolled .nav-link::after {
    background-color: var(--color-accent);
}

.header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100px;
    padding: 0 60px;
    max-width: 1600px;
    margin: 0 auto;
    transition: var(--transition-luxury);
}

@media (max-width: 1024px) {
    .header-container {
        padding: 0 30px;
        height: 80px;
    }
}

.desktop-nav {
    flex: 1;
}

.desktop-nav.nav-left ul {
    display: flex;
    justify-content: flex-start;
    gap: 40px;
}

.desktop-nav.nav-right ul {
    display: flex;
    justify-content: flex-end;
    gap: 40px;
}

.nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-secondary);
    padding: 8px 0;
    position: relative;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: var(--color-secondary);
    transition: var(--transition-standard);
    transform: translateX(-50%);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.logo-container {
    text-align: center;
}

.logo-text {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    color: var(--color-secondary);
    display: inline-block;
    padding-left: 0.28em; /* Offset letter-spacing centering issue */
    transition: var(--transition-luxury);
}

.header-utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
    flex: 1;
}

.utility-btn {
    font-size: 1.1rem;
    color: var(--color-secondary);
    transition: var(--transition-standard);
    position: relative;
}

.utility-btn:hover {
    color: var(--color-accent) !important;
    transform: translateY(-2px);
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.6rem;
    font-weight: 600;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mobile-nav-toggle {
    display: none;
    font-size: 1.3rem;
    color: var(--color-secondary);
}

@media (max-width: 1024px) {
    .desktop-nav {
        display: none;
    }
    .mobile-nav-toggle {
        display: block;
        flex: 1;
        text-align: left;
    }
    .logo-container {
        flex: 2;
    }
    .logo-text {
        font-size: 2rem;
    }
}

/* Premium Drawers */
.mobile-drawer, .cart-drawer {
    position: fixed;
    top: 0;
    height: 100%;
    width: 480px;
    max-width: 100%;
    background-color: var(--color-secondary);
    z-index: 2000;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.03);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
}

.drawer-header {
    padding: 35px 50px;
    border-bottom: 1px solid var(--color-border-thin);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.drawer-title {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--color-text-dark);
}

.drawer-close {
    font-size: 2.2rem;
    font-weight: 200;
    line-height: 1;
    transition: var(--transition-standard);
}

.drawer-close:hover {
    color: var(--color-accent);
}

/* Mobile Menu Left Drawer */
.mobile-drawer {
    left: 0;
    transform: translateX(-100%);
}

.mobile-drawer.open {
    transform: translateX(0);
}

.mobile-menu-links {
    padding: 50px;
}

.mobile-menu-links li {
    margin-bottom: 30px;
}

.mobile-link {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    display: block;
}

.mobile-link:hover {
    color: var(--color-accent);
    transform: translateX(10px);
}

/* Cart Drawer (Right) */
.cart-drawer {
    right: 0;
    transform: translateX(100%);
}

.cart-drawer.open {
    transform: translateX(0);
}

.cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 7, 7, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.cart-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
}

.cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 50px;
}

.empty-cart-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
}

.empty-icon {
    font-size: 2.5rem;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.empty-cart-state p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 35px;
}

.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 35px;
}

.cart-item {
    display: flex;
    gap: 25px;
    align-items: flex-start;
    border-bottom: 1px solid var(--color-border-thin);
    padding-bottom: 30px;
}

.cart-item-img {
    width: 100px;
    height: 135px;
    object-fit: cover;
}

.cart-item-details {
    flex: 1;
}

.cart-item-details h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 6px;
    color: var(--color-text-dark);
}

.cart-item-variant {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.cart-item-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

.cart-item-qty {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 15px;
}

.qty-btn {
    border: 1px solid var(--color-border-thin);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    transition: var(--transition-standard);
}

.qty-btn:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-secondary);
}

.qty-val {
    font-size: 0.85rem;
    font-weight: 500;
}

.cart-item-remove {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    margin-top: 15px;
    display: inline-block;
    transition: var(--transition-standard);
}

.cart-item-remove:hover {
    color: #ff3b30;
}

.cart-footer {
    padding: 35px 50px;
    border-top: 1px solid var(--color-border-thin);
    background-color: var(--color-bg-cream);
}

.cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 12px;
}

.subtotal-amount {
    color: var(--color-primary);
    font-family: var(--font-body);
    font-weight: 600;
}

.shipping-tax-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 30px;
}

/* Fullscreen Minimal Search Overlay */
.search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(251, 249, 246, 0.99);
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.search-overlay.open {
    opacity: 1;
    visibility: visible;
}

.search-close {
    position: absolute;
    top: 50px;
    right: 60px;
    font-size: 3rem;
    font-weight: 200;
    line-height: 1;
    transition: var(--transition-standard);
}

.search-close:hover {
    color: var(--color-accent);
}

.search-overlay-content {
    width: 100%;
    max-width: 900px;
    padding: 0 60px;
    text-align: center;
}

.search-heading {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    margin-bottom: 40px;
}

.search-form {
    position: relative;
    border-bottom: 1.5px solid var(--color-primary);
    display: flex;
    align-items: center;
    padding-bottom: 15px;
}

.search-input {
    width: 100%;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    padding-right: 60px;
}

.search-submit-btn {
    font-size: 1.8rem;
    transition: var(--transition-standard);
}

.search-submit-btn:hover {
    transform: translateX(10px);
    color: var(--color-accent);
}

.search-suggestions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.suggestion-tag {
    background-color: var(--color-secondary);
    border: 1px solid var(--color-border-thin);
    padding: 10px 24px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: var(--transition-standard);
}

.suggestion-tag:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-secondary);
}

/* Premium Hero Section */
.hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    text-align: center;
    overflow: hidden;
}

.hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    animation: zoomOut 24s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.55) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    padding: 0 40px;
    margin-top: 60px;
}

.hero-subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 25px;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-title {
    font-size: 5.5rem;
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 30px;
    text-shadow: 0 10px 30px rgba(0,0,0,0.1);
    animation: fadeInUp 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-description {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 50px;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-actions {
    display: flex;
    justify-content: center;
    gap: 25px;
    animation: fadeInUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@media (max-width: 768px) {
    .hero-title {
        font-size: 3.2rem;
    }
    .hero-description {
        font-size: 1rem;
    }
    .hero-actions {
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }
    .hero-actions .btn {
        width: 100%;
        max-width: 320px;
    }
}

.scroll-indicator {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.scroll-text {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
}

.scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 100%);
    animation: pulseScroll 2.2s infinite;
}

@keyframes zoomOut {
    0% { transform: scale(1.08); }
    100% { transform: scale(1.01); }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulseScroll {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
}

/* Luxury Brand Pitch */
.brand-pitch {
    padding: 140px 0;
    background-color: var(--color-secondary);
}

.section-title-alt {
    font-size: 2.6rem;
    margin-bottom: 80px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.pitch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 70px;
}

@media (max-width: 991px) {
    .pitch-grid {
        grid-template-columns: 1fr;
        gap: 50px;
    }
}

.pitch-card {
    padding: 0 10px;
}

.pitch-icon {
    font-size: 2.2rem;
    color: var(--color-accent);
    margin-bottom: 30px;
}

.pitch-card h3 {
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    font-weight: 500;
}

.pitch-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.8;
}

/* Elegant Collections Grid */
.collections-section {
    padding: 140px 0;
}

.section-title {
    font-size: 2.6rem;
    margin-bottom: 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
}

@media (max-width: 991px) {
    .collections-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

.collection-card {
    position: relative;
    height: 600px;
    overflow: hidden;
    background-color: var(--color-primary);
}

.collection-img-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: 0.95;
    transition: var(--transition-luxury);
}

.collection-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.collection-card:hover .collection-img {
    transform: scale(1.08);
}

.collection-card:hover .collection-img-wrapper {
    opacity: 0.75;
}

.collection-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 50px;
    background: linear-gradient(360deg, rgba(7,7,7,0.85) 0%, rgba(7,7,7,0) 100%);
    color: var(--color-secondary);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 10;
}

.collection-content h3 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    font-weight: 300;
    letter-spacing: 0.02em;
}

.collection-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-accent);
}

.collection-link i {
    margin-left: 8px;
    transition: var(--transition-standard);
}

.collection-card:hover .collection-link i {
    transform: translateX(8px);
}

/* Premium Products Grid (High Fashion Layout) */
.products-section {
    padding: 140px 0;
    background-color: var(--color-secondary);
}

.section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 70px;
}

@media (max-width: 768px) {
    .section-header-flex {
        flex-direction: column;
        align-items: flex-start;
        gap: 30px;
    }
}

.product-filters {
    display: flex;
    gap: 40px;
}

.filter-tab {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    cursor: pointer;
    padding-bottom: 8px;
    border-bottom: 1.5px solid transparent;
    transition: var(--transition-standard);
}

.filter-tab.active, .filter-tab:hover {
    color: var(--color-primary);
    border-color: var(--color-accent);
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px 40px;
}

@media (max-width: 1024px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .products-grid {
        grid-template-columns: 1fr;
    }
}

.product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-secondary);
    transition: var(--transition-luxury);
}

.product-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 6px 16px;
    z-index: 10;
}

.product-img-wrapper {
    position: relative;
    height: 520px;
    overflow: hidden;
    background-color: var(--color-bg-cream);
    margin-bottom: 25px;
}

.product-primary-img, .product-secondary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
}

.product-card:hover .product-secondary-img {
    opacity: 1;
    transform: scale(1.04);
}

.product-card:hover .product-primary-img {
    transform: scale(1.04);
}

/* Sleek Quick buy bottom overlay */
.product-hover-actions {
    position: absolute;
    bottom: -60px;
    left: 0;
    width: 100%;
    display: flex;
    gap: 1px;
    transition: var(--transition-luxury);
    opacity: 0;
    z-index: 10;
}

.product-card:hover .product-hover-actions {
    bottom: 0;
    opacity: 1;
}

.product-hover-btn {
    flex: 1;
    background-color: var(--color-primary);
    color: var(--color-secondary);
    border: none;
    padding: 18px 0;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    transition: var(--transition-standard);
}

.product-hover-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-primary);
}

.product-info {
    text-align: left;
    padding: 0 5px;
}

.product-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 8px;
    font-weight: 400;
    color: var(--color-text-dark);
}

.product-price {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

/* Premium Promo Section */
.promo-banner {
    position: relative;
    padding: 240px 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: var(--color-secondary);
    text-align: center;
    overflow: hidden;
}

.promo-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 7, 7, 0.7);
}

.promo-content {
    position: relative;
    z-index: 10;
    max-width: 850px;
    margin: 0 auto;
}

.promo-content h2 {
    font-size: 3.5rem;
    margin-bottom: 25px;
    font-weight: 300;
    letter-spacing: 0.02em;
}

.promo-content p {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 45px;
}

@media (max-width: 768px) {
    .promo-content h2 {
        font-size: 2.5rem;
    }
    .promo-content p {
        font-size: 1rem;
    }
}

/* Elite Newsletter Form */
.newsletter-section {
    padding: 140px 0;
    background-color: #f6f3f0; /* Alabaster Soft Gray Cream */
}

.newsletter-section h2 {
    font-size: 2.6rem;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
}

.newsletter-section p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 50px;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.8;
}

.newsletter-form {
    display: flex;
    max-width: 700px;
    margin: 0 auto;
    border-bottom: 1.5px solid var(--color-primary);
}

.newsletter-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    padding: 18px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-primary);
}

.newsletter-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
}

.newsletter-form .btn {
    padding: 18px 45px;
}

/* Elite Quick View Modal styling */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 7, 7, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 2001;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;
}

.quick-view-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: 1000px;
    max-width: 90%;
    max-height: 90vh;
    background-color: var(--color-secondary);
    z-index: 2002;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 30px 70px rgba(0,0,0,0.08);
    transition: var(--transition-luxury);
    overflow-y: auto;
}

.quick-view-modal.open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.modal-close {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 2.2rem;
    font-weight: 200;
    z-index: 10;
    line-height: 1;
    transition: var(--transition-standard);
}

.modal-close:hover {
    color: var(--color-accent);
}

.modal-body {
    padding: 60px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
}

@media (max-width: 991px) {
    .modal-body {
        grid-template-columns: 1fr;
        padding: 50px 30px;
        gap: 40px;
    }
}

.modal-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 550px;
}

.modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.modal-info-col h3 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    margin-bottom: 12px;
}

.modal-price {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.modal-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 35px;
}

.modal-options-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 15px;
    color: var(--color-text-dark);
}

.modal-options-grid {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
}

.option-select {
    border: 1px solid var(--color-border-thin);
    padding: 12px 20px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: var(--transition-standard);
}

.option-select.active, .option-select:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-secondary);
}

.modal-qty-container {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-bottom: 35px;
}

.modal-qty-container .qty-btn {
    width: 32px;
    height: 32px;
}

.modal-qty-container .qty-val {
    font-size: 0.95rem;
}

/* Elite Footer Layout */
footer {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    padding: 100px 0 40px 0;
    border-top: 1px solid #141414;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 60px;
    margin-bottom: 80px;
}

@media (max-width: 991px) {
    .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 50px;
    }
}

@media (max-width: 576px) {
    .footer-grid {
        grid-template-columns: 1fr;
    }
}

.brand-col h3 {
    font-size: 2rem;
    letter-spacing: 0.25em;
    margin-bottom: 25px;
}

.brand-mission {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.8;
    margin-bottom: 30px;
    max-width: 380px;
}

.social-links {
    display: flex;
    gap: 25px;
}

.social-links a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.2rem;
}

.social-links a:hover {
    color: var(--color-accent);
    transform: translateY(-3px);
}

.footer-col h4 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 30px;
    color: var(--color-accent);
}

.footer-col ul li {
    margin-bottom: 18px;
}

.footer-col ul li a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    display: inline-block;
}

.footer-col ul li a:hover {
    color: var(--color-secondary);
    transform: translateX(5px);
}

.footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 40px;
}

.bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
}

@media (max-width: 768px) {
    .bottom-flex {
        flex-direction: column;
        gap: 25px;
        text-align: center;
    }
}

.payment-methods {
    display: flex;
    gap: 20px;
    font-size: 1.6rem;
}

.payment-methods i {
    color: rgba(255, 255, 255, 0.4);
}
