/* State-of-the-Art Enoleh-Style Minimalist Luxury Styling System */
<link rel="stylesheet" href="{{ 'styles.css' | asset_url }}&v=15" type="text/css" media="all">

:root {
    /* Pastel palette */
    --color-pastel-1: #ffb3ab;   /* Peach */
    --color-pastel-2: #c2f2c2;   /* Mint */
    --color-primary: #fafafa;   /* Light background */
    --color-secondary: #000000; /* Black accents */
    --color-bg-dark: #f0f0f0;   /* Darker bg for dark mode */
    --color-bg-card: rgba(255,255,255,0.45); /* Glass card bg */
    --color-accent: #ffb3ab;   /* Use pastel as accent */
    --color-accent-hover: #c2f2c2;
    --color-text-light: #111111;
    --color-text-muted: #777777;
    --color-border-thin: rgba(0,0,0,0.08);
    --color-border-medium: rgba(0,0,0,0.15);
    
    --font-heading: 'Outfit', sans-serif; /* New heading font */
    --font-body: 'Inter', sans-serif;
    
    --blur-radius: 16px; /* Glass‑morphism blur */
    
    --transition-luxury: all 0.6s cubic-bezier(0.16,1,0.3,1);
    --transition-standard: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
}

/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

ul, li {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0;
    margin: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--color-primary);
}

body {
    font-family: var(--font-body);
    background-color: #fafafa;
    color: var(--color-text-light);
    line-height: 1.65;
    letter-spacing: -0.01em;
    overflow-x: hidden;
    transition: var(--transition-standard);
}

.container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 60px;
}

@media (max-width: 991px) {
    .container {
        padding: 0 30px;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 20px;
    }
}

a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition-standard);
}

button {
    font-family: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-secondary);
}

.text-center {
    text-align: center;
}

/* Elite Buttons */
.btn {
    display: inline-block;
    padding: 16px 40px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    cursor: pointer;
    position: relative;
    z-index: 1;
    overflow: hidden;
    transition: var(--transition-luxury);
    border-radius: 0;
}

.btn-gold {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    font-weight: 600;
    border-radius: 0 !important;
    box-shadow: none !important;
    transition: var(--transition-standard);
}

.btn-gold:hover {
    background-color: #333333;
    color: #ffffff !important;
    border-color: #333333;
    box-shadow: none !important;
    transform: none !important;
}

.btn-outline {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000000;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.btn-outline:hover {
    color: var(--color-primary);
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
}

#main-header {
    position: absolute;
    top: 38px;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition-luxury);
    background-color: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

#main-header.header-transparent {
    background-color: transparent;
}

#main-header.header-scrolled {
    position: fixed !important;
    top: 0 !important;
    background-color: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
}

#main-header.header-transparent .logo-text,
#main-header.header-transparent .nav-link,
#main-header.header-transparent .utility-btn {
    color: #ffffff !important;
}

#main-header.header-scrolled .logo-text,
#main-header.header-scrolled .nav-link,
#main-header.header-scrolled .utility-btn {
    color: #000000 !important;
}

/* Header Hover Highlight State */
#main-header:hover {
    background-color: rgba(255, 255, 255, 0.98) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02) !important;
}

#main-header:hover .logo-text,
#main-header:hover .nav-link,
#main-header:hover .utility-btn {
    color: #000000 !important;
}

.nav-link::after {
    display: none !important;
}

.header-container {
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(var(--blur-radius));
    -webkit-backdrop-filter: blur(var(--blur-radius));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100px;
    padding: 0 40px !important;
    max-width: 100% !important;
    width: 100% !important;
    margin: 0 !important;
    transition: var(--transition-luxury);
}

@media (max-width: 1024px) {
    .header-container {
        padding: 0 30px;
        height: 80px;
    }
}

.desktop-nav {
    flex: 1;
}

.desktop-nav.nav-left ul {
    display: flex;
    justify-content: flex-start;
    gap: 40px;
}

.desktop-nav.nav-right ul {
    display: flex;
    justify-content: flex-end;
    gap: 40px;
}

.nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    padding: 8px 0;
    position: relative;
    opacity: 0.85;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: var(--transition-standard);
    transform: translateX(-50%);
}

/* Header SHOP Dropdown Menu Styles */
.nav-dropdown-wrapper {
    position: relative;
}

.header-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: linear-gradient(135deg, rgba(255,179,171,0.9), rgba(194,242,194,0.9));
    backdrop-filter: blur(var(--blur-radius));
    -webkit-backdrop-filter: blur(var(--blur-radius));
    min-width: 200px;
    display: flex;
    flex-direction: column;
    padding: 20px 24px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
    z-index: 1000;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    text-align: left;
}

.nav-dropdown-wrapper:hover .header-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.header-dropdown-menu a {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    color: #000000 !important;
    text-decoration: none;
    padding: 8px 0;
    letter-spacing: 0.15em;
    transition: color 0.2s ease, padding-left 0.2s ease;
    text-transform: uppercase;
    display: block;
    border: none !important;
}

.header-dropdown-menu a:hover {
    color: #888888 !important;
    padding-left: 5px;
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.nav-link:hover {
    opacity: 1;
}

.logo-container {
    text-align: center;
}

.logo-text {
    font-family: 'Inter', sans-serif !important;
    font-size: 1.8rem !important;
    font-weight: 300 !important;
    text-transform: lowercase !important;
    letter-spacing: -0.02em !important;
    color: var(--color-secondary);
    display: inline-block;
    padding-left: 0 !important;
    transition: var(--transition-luxury);
}

.logo-text:hover {
    color: var(--color-accent) !important;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
}

.header-utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
    flex: 1;
}

.utility-btn {
    font-size: 1.1rem;
    color: #ffffff;
    transition: var(--transition-standard);
    position: relative;
    opacity: 0.85;
}

.utility-btn:hover {
    color: var(--color-accent) !important;
    transform: translateY(-2px);
    opacity: 1;
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.6rem;
    font-weight: 600;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mobile-nav-toggle {
    display: none;
    font-size: 1.3rem;
    color: var(--color-secondary);
}

@media (max-width: 1024px) {
    .desktop-nav {
        display: none;
    }
    .mobile-nav-toggle {
        display: block;
        flex: 1;
        text-align: left;
    }
    .logo-container {
        flex: 2;
    }
    .logo-text {
        font-size: 1.8rem;
    }
}

@media (max-width: 768px) {
    .logo-text {
        font-size: 1.35rem !important;
        letter-spacing: 0.12em !important;
        padding-left: 0.12em !important;
    }
    .header-container {
        padding: 0 20px !important;
        height: 75px !important;
    }
    .header-utilities {
        gap: 15px !important;
    }
}

@media (max-width: 375px) {
    .logo-text {
        font-size: 1.1rem !important;
        letter-spacing: 0.06em !important;
        padding-left: 0.06em !important;
    }
}

/* Obsidian Drawers */
.mobile-drawer, .cart-drawer {
    position: fixed;
    top: 0;
    height: 100%;
    width: 480px;
    max-width: 100%;
    background-color: var(--color-bg-card);
    border-left: 1px solid var(--color-border-thin);
    z-index: 2000;
    box-shadow: -15px 0 50px rgba(0, 0, 0, 0.3);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
}

.mobile-drawer {
    border-left: none;
    border-right: 1px solid var(--color-border-thin);
}

.drawer-header {
    padding: 35px 50px;
    border-bottom: 1px solid var(--color-border-thin);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.drawer-title {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--color-secondary);
}

.drawer-close {
    font-size: 2.2rem;
    font-weight: 200;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.drawer-close:hover {
    color: var(--color-accent);
}

/* Mobile Menu Left Drawer */
.mobile-drawer {
    left: 0;
    transform: translateX(-100%);
}

.mobile-drawer.open {
    transform: translateX(0);
}

.mobile-menu-links {
    padding: 30px;
}

.mobile-menu-links li {
    margin-bottom: 0;
}

.mobile-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    display: block;
    color: var(--color-text-light);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 20px 0;
    transition: var(--transition-standard);
}

.mobile-link:hover {
    color: var(--color-accent);
    padding-left: 10px;
    border-bottom-color: var(--color-accent);
}

/* Cart Drawer (Right) */
.cart-drawer {
    right: 0;
    transform: translateX(100%);
}

.cart-drawer.open {
    transform: translateX(0);
}

.cart-drawer-overlay, .mobile-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.cart-drawer-overlay.open, .mobile-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
}

.cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 50px;
}

.empty-cart-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
}

.empty-icon {
    font-size: 2.5rem;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.empty-cart-state p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 35px;
}

.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 35px;
}

.cart-item {
    display: flex;
    gap: 25px;
    align-items: flex-start;
    border-bottom: 1px solid var(--color-border-thin);
    padding-bottom: 30px;
}

.cart-item-img {
    width: 100px;
    height: 135px;
    object-fit: cover;
}

.cart-item-details {
    flex: 1;
}

.cart-item-details h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 6px;
    color: var(--color-secondary);
}

.cart-item-variant {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.cart-item-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

.cart-item-qty {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 15px;
}

.qty-btn {
    border: 1px solid var(--color-border-thin);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.qty-btn:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-primary);
}

.qty-val {
    font-size: 0.85rem;
    font-weight: 500;
}

.cart-item-remove {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    margin-top: 15px;
    display: inline-block;
    transition: var(--transition-standard);
}

.cart-item-remove:hover {
    color: #ff3b30;
}

.cart-footer {
    padding: 35px 50px;
    border-top: 1px solid var(--color-border-thin);
    background-color: #0d0d0d;
}

.cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 12px;
}

.subtotal-amount {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-weight: 600;
}

.shipping-tax-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 30px;
}

/* Fullscreen Minimal Search Overlay (Dark) */
.search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.99);
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.search-overlay.open {
    opacity: 1;
    visibility: visible;
}

.search-close {
    position: absolute;
    top: 50px;
    right: 60px;
    font-size: 3rem;
    font-weight: 200;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.search-close:hover {
    color: var(--color-accent);
}

.search-overlay-content {
    width: 100%;
    max-width: 900px;
    padding: 0 60px;
    text-align: center;
}

.search-heading {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--color-secondary);
    margin-bottom: 40px;
}

.search-form {
    position: relative;
    border-bottom: 1.5px solid var(--color-accent);
    display: flex;
    align-items: center;
    padding-bottom: 15px;
}

.search-input {
    width: 100%;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-secondary);
    padding-right: 60px;
}

.search-submit-btn {
    font-size: 1.8rem;
    color: var(--color-accent);
    transition: var(--transition-standard);
}

.search-submit-btn:hover {
    transform: translateX(10px);
    color: var(--color-secondary);
}

.search-suggestions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.suggestion-tag {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-thin);
    padding: 10px 24px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.suggestion-tag:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-primary);
}

/* Premium Hero Section */
.hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-align: center;
    overflow: hidden;
}

.hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    animation: zoomOut 24s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.65) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    padding: 0 40px;
    margin-top: 60px;
}

.hero-subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 25px;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-title {
    font-size: 5.5rem;
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 30px;
    text-shadow: 0 10px 40px rgba(0,0,0,0.4);
    animation: fadeInUp 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-description {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 50px;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-actions {
    display: flex;
    justify-content: center;
    gap: 25px;
    animation: fadeInUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@media (max-width: 768px) {
    .hero-title {
        font-size: clamp(2rem, 8vw, 3.8rem);
    }
    .hero-description {
        font-size: 1rem;
        padding: 0 10px;
    }
    .hero-actions {
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }
    .hero-actions .btn {
        width: 100%;
        max-width: 320px;
    }
}

.scroll-indicator {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.scroll-text {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
}

.scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 100%);
    animation: pulseScroll 2.2s infinite;
}

@keyframes zoomOut {
    0% { transform: scale(1.08); }
    100% { transform: scale(1.01); }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulseScroll {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
}

/* Luxury Brand Pitch */
.brand-pitch {
    padding: 140px 0;
    background-color: var(--color-bg-dark);
    border-bottom: 1px solid var(--color-border-thin);
}

.section-title-alt {
    font-size: 2.6rem;
    margin-bottom: 80px;
    text-transform: uppercase;
