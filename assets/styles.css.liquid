.royal-hero-overlay {
    position: absolute;
    top:0; left:0; width:100%; height:100%;
    background-color: rgba(46, 26, 34, 0.55);
}

.royal-hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: #ffffff;
    max-width: 750px;
}

.royal-subtitle {
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 25px;
}

.royal-title {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 300;
