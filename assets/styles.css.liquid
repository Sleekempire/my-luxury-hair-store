/* Elite Quick View Modal styling */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    z-index: 2001;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;
}

.quick-view-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: 1000px;
    max-width: 90%;
    max-height: 90vh;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-thin);
    z-index: 2002;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    transition: var(--transition-luxury);
    overflow-y: auto;
}

.quick-view-modal.open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.modal-close {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 2.2rem;
    font-weight: 200;
    z-index: 10;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

