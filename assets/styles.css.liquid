/* Bundles Slider Section */
.enoleh-bundles-section {
    padding: 40px 0 60px 0;
    background-color: var(--color-primary);
    border-top: none !important;
}

/* Custom Section Partition Divider */
.enoleh-partition {
    border: 0;
    height: 1px;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
    margin: 40px auto;
    width: 80%;
    max-width: 1200px;
    position: relative;
}

.enoleh-partition::after {
    content: "♦";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-primary);
    padding: 0 10px;
    color: var(--color-accent);
    font-size: 0.55rem;
}

.enoleh-bundles-carousel-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
}

.enoleh-bundles-grid {
    display: flex !important;
    flex-direction: row;
    gap: 30px;
    margin-bottom: 45px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 5px;
}

.enoleh-bundles-grid::-webkit-scrollbar {
    display: none;
}

.enoleh-bundle-card {
    flex: 0 0 calc(25% - 22.5px);
    text-align: center;
    scroll-snap-align: start;
    transition: transform 0.4s ease;
}

.enoleh-bundle-card:hover {
    transform: translateY(-4px);
}

.enoleh-bundle-img-wrapper {
    aspect-ratio: 1/1;
    overflow: hidden;
    margin-bottom: 20px;
    background-color: #fafafa;
}

.enoleh-bundle-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.enoleh-bundle-name {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #000000;
    margin-bottom: 6px;
    text-transform: lowercase;
