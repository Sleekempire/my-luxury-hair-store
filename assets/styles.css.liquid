    justify-content: center;
    gap: 8px;
}

.enoleh-carousel-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #eaeaea;
    cursor: pointer;
    transition: background-color 0.3s;
}

.enoleh-carousel-dots .dot.active {
    background-color: #000000;
}

/* Seamless Gallery Autoplay Marquee Section */
.enoleh-gallery-section {
    padding: 20px 0;
