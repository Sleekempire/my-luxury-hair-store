/* Announcement Bar */
.announcement-bar {
    background-color: var(--color-accent);
    color: var(--color-primary);
    text-align: center;
    padding: 10px 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    position: relative;
    z-index: 1001;
}

/* Founder Editorial Section */
