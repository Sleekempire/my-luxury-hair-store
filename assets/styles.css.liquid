    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.couture-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.couture-overlay {
    position: absolute;
    top:0; left:0; width:100%; height:100%;
    background-color: rgba(46, 26, 34, 0.4);
}

.couture-hero-frame-container {
    position: relative;
