.collection-card {
    position: relative;
    height: 600px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    transition: var(--transition-luxury);
}

.collection-card:hover {
    border-color: rgba(197, 168, 128, 0.35);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
}

.collection-img-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: 0.8;
    transition: var(--transition-luxury);
    position: relative;
}

.collection-img-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.25) 50%, 
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    transition: 0.75s;
    z-index: 5;
}

.collection-card:hover .collection-img-wrapper::after {
    left: 150%;
}

.collection-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.collection-card:hover .collection-img {
    transform: scale(1.08);
}

.collection-card:hover .collection-img-wrapper {
    opacity: 0.55;
    filter: grayscale(20%);
}

.collection-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 50px;
    background: linear-gradient(360deg, rgba(5,5,5,0.9) 0%, rgba(5,5,5,0) 100%);
    color: var(--color-secondary);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 10;
}

.collection-content h3 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    font-weight: 300;
    letter-spacing: 0.02em;
}

.collection-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-accent);
}

.collection-link i {
    margin-left: 8px;
    transition: var(--transition-standard);
}

.collection-card:hover .collection-link i {
    transform: translateX(8px);
}

