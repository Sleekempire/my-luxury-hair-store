    padding: 140px 0;
    background-color: var(--color-bg-dark);
    border-bottom: 1px solid var(--color-border-thin);
}

.founder-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.founder-img-col {
    position: relative;
}

.founder-img-frame {
    width: 100%;
    overflow: hidden;
    background-color: var(--color-primary);
    border: 1px solid var(--color-border-thin);
}

.founder-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: var(--transition-luxury);
}

.founder-img-frame:hover .founder-img {
    transform: scale(1.03);
}

.founder-text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.editorial-label {
    font-size: 0.75rem;
    font-weight: 600;
