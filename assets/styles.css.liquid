    line-height: 1.5;
}

.couture-quote-author {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.25em;
}

.couture-slider-indicators {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
}

.couture-slider-indicators .indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-border-medium);
}

.couture-slider-indicators .indicator.active {
    background-color: var(--color-accent);
}

@media (max-width: 991px) {
    .oval-grid {
        grid-template-columns: 1fr;
    }
    .oval-img-frame {
        width: 220px;
        height: 320px;
    }
    .couture-quote-text {
        font-size: 1.6rem;
    }
    .couture-hero-frame {
        padding: 40px;
    }
}

/* --------------------------------------------------------------------------
   DESIGN 4: BOLD STREETWEAR LUXURY OVERRIDES
   -------------------------------------------------------------------------- */
.collage-hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 90vh;
    align-items: center;
    padding: 60px;
    background-color: #0d0d0d;
    color: #ffffff;
}

.collage-left {
    padding-right: 60px;
}

.collage-title {
    font-family: var(--font-body);
    font-size: 6.5rem;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin-bottom: 40px;
}

.collage-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #a0a0a0;
    margin-bottom: 45px;
    max-width: 480px;
}

.btn-bold-street {
    display: inline-block;
    padding: 18px 45px;
    background-color: #ffffff;
    color: #000000;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border: none;
    transition: var(--transition-standard);
}

.btn-bold-street:hover {
    background-color: var(--color-accent);
    color: #ffffff;
}

.collage-right {
    position: relative;
    height: 600px;
}

.img-main {
    position: absolute;
    top: 0; left: 0; width: 75%; height: 80%;
    z-index: 2;
}

.img-sub {
    position: absolute;
    bottom: 0; right: 0; width: 55%; height: 60%;
    z-index: 3;
    border: 5px solid #0d0d0d;
}

.collage-img-box img {
    width: 100%; height: 100%; object-fit: cover;
}

/* Sliding Ticker Marquee */
.street-ticker-container {
    background-color: var(--color-accent);
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    padding: 20px 0;
    border-top: 1px solid rgba(0,0,0,0.1);
}

.street-ticker {
    display: inline-block;
    animation: marquee 25s linear infinite;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.25em;
}

@keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
}

.street-section-header {
    border-bottom: 2px solid var(--color-secondary);
    padding-bottom: 20px;
    margin-bottom: 60px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}

.street-section-header h2 {
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: 0.05em;
}

/* Street Products Grid (Solid block borders) */
.grid-street {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0px;
    border-top: 1px solid var(--color-secondary);
    border-left: 1px solid var(--color-secondary);
}

.grid-street .product-card {
    border-right: 1px solid var(--color-secondary) !important;
    border-bottom: 1px solid var(--color-secondary) !important;
    border-left: none !important;
    border-top: none !important;
    padding: 30px;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.grid-street .product-card:hover {
    background-color: var(--color-bg-dark);
}

/* Tech Specs Table */
.tech-spotlight-section {
    padding: 120px 0;
    background-color: var(--color-bg-dark);
}

.tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.tech-img img {
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--color-border-thin);
}

.tech-label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.25em;
    color: var(--color-accent);
}

.tech-title {
    font-size: 3rem;
    font-weight: 900;
    margin: 20px 0 40px 0;
}

.specs-table {
    margin-bottom: 40px;
    border-top: 1px solid var(--color-border-thin);
}

.specs-row {
    display: flex;
    justify-content: space-between;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border-thin);
    font-size: 0.9rem;
}

.specs-row span:first-child {
    font-weight: 700;
    color: var(--color-text-muted);
}

.specs-row span:last-child {
    font-weight: 500;
}

.street-reviews-section {
    padding: 120px 0;
}

.street-reviews-title {
    font-size: 2.2rem;
    font-weight: 900;
    text-align: center;
    margin-bottom: 80px;
}

.street-reviews-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

.street-review-card {
    border: 1px solid var(--color-secondary);
    padding: 50px;
}

.street-review-card .quote-mark {
    font-size: 3.5rem;
    line-height: 1;
    font-family: var(--font-heading);
    color: var(--color-accent);
    display: block;
    margin-bottom: 20px;
}

.street-review-card p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 30px;
}

.street-review-card h5 {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
}

.street-newsletter-section {
    background-color: var(--color-secondary);
    color: #ffffff;
    padding: 120px 0;
}

.street-newsletter-section h2 {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    margin-bottom: 40px;
}

.street-newsletter-form {
    display: flex;
    max-width: 700px;
    margin: 0 auto;
}

.street-newsletter-input {
    flex: 1;
    border: 2px solid #ffffff;
    border-right: none;
    background: none;
    padding: 18px 25px;
    font-size: 1rem;
    color: #ffffff;
    outline: none;
}

.street-newsletter-btn {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
    padding: 0 40px;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    cursor: pointer;
}

@media (max-width: 991px) {
    .collage-hero-section {
        grid-template-columns: 1fr;
        padding: 40px 20px;
    }
    .collage-title {
        font-size: 4rem;
    }
    .collage-right {
        height: 420px;
        margin-top: 40px;
    }
    .grid-street {
        grid-template-columns: repeat(2, 1fr);
    }
    .tech-grid {
        grid-template-columns: 1fr;
    }
    .street-reviews-grid {
        grid-template-columns: 1fr;
    }
}

/* --------------------------------------------------------------------------
   DESIGN 5: ROYAL ELITE OVERRIDES
   -------------------------------------------------------------------------- */
.royal-hero-section {
    padding: 40px;
}

.royal-hero-frame {
    position: relative;
    border: 1px solid var(--color-accent);
    padding: 10px;
    height: 80vh;
