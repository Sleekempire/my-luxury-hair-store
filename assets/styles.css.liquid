/* CSS Design System for Enoléh Inspired Luxury Store */

:root {
    --color-primary: #0d0d0d;       /* Onyx Black */
    --color-secondary: #ffffff;     /* White */
    --color-accent: #d4af37;        /* Metallic Gold */
    --color-accent-hover: #b8952b;  /* Darker Gold */
    --color-bg-ivory: #faf8f5;      /* Off-white Cream */
    --color-text-dark: #1c1c1c;     /* Soft Black */
    --color-text-muted: #6e6e73;    /* Apple Muted Gray */
    --color-border: #e5e5e7;        /* Light Gray */
    --color-shadow: rgba(0, 0, 0, 0.05);
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Inter', sans-serif;
    --transition-smooth: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --transition-fast: all 0.2s ease-in-out;
}

/* Reset and Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: var(--font-body);
    background-color: var(--color-bg-ivory);
    color: var(--color-text-dark);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
}

@media (max-width: 768px) {
    .container {
        padding: 0 20px;
    }
}

a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition-fast);
}

ul {
    list-style: none;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* Typography Utility */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: 0.5px;
}

.text-center {
    text-align: center;
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 15px 35px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: var(--transition-smooth);
    border-radius: 0;
}

.btn-gold {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    border-color: var(--color-primary);
}

.btn-gold:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-primary);
}

.btn-outline {
    background-color: transparent;
    color: var(--color-secondary);
    border-color: var(--color-secondary);
}

.btn-outline:hover {
    background-color: var(--color-secondary);
    color: var(--color-primary);
}

/* Header & Navigation */
#main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition-smooth);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

#main-header.header-transparent {
    background-color: transparent;
}

#main-header.header-scrolled {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
}

#main-header.header-scrolled .logo-text,
#main-header.header-scrolled .nav-link,
#main-header.header-scrolled .utility-btn {
    color: var(--color-primary);
}

.header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 90px;
    padding: 0 50px;
    max-width: 1800px;
    margin: 0 auto;
    transition: var(--transition-smooth);
}

@media (max-width: 1024px) {
    .header-container {
        padding: 0 20px;
        height: 70px;
    }
}

.desktop-nav {
    flex: 1;
}

.desktop-nav.nav-left ul {
    display: flex;
    justify-content: flex-start;
    gap: 35px;
}

.desktop-nav.nav-right ul {
    display: flex;
    justify-content: flex-end;
    gap: 35px;
}

.nav-link {
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-secondary);
    padding: 10px 0;
    position: relative;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: var(--transition-smooth);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.logo-container {
    text-align: center;
}

.logo-text {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: 5px;
    color: var(--color-secondary);
    display: block;
}

.header-utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 25px;
    flex: 1;
}

.utility-btn {
    background: none;
    border: none;
    font-size: 1.15rem;
    color: var(--color-secondary);
    cursor: pointer;
    position: relative;
    transition: var(--transition-fast);
}

.utility-btn:hover {
    color: var(--color-accent) !important;
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 600;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mobile-nav-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.4rem;
    color: var(--color-secondary);
    cursor: pointer;
}

@media (max-width: 1024px) {
    .desktop-nav {
        display: none;
    }
    .mobile-nav-toggle {
        display: block;
        flex: 1;
        text-align: left;
    }
    .logo-container {
        flex: 2;
    }
    .logo-text {
        font-size: 1.8rem;
    }
}

/* Drawers & Overlays - Base */
.mobile-drawer, .cart-drawer {
    position: fixed;
    top: 0;
    height: 100%;
    width: 450px;
    max-width: 100%;
    background-color: var(--color-secondary);
    z-index: 2000;
    box-shadow: -10px 0 30px rgba(0,0,0,0.05);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
}

.drawer-header {
    padding: 30px 40px;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.drawer-title {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 2px;
}

.drawer-close {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    font-weight: 300;
    line-height: 1;
    transition: var(--transition-fast);
}

.drawer-close:hover {
    color: var(--color-accent);
}

/* Mobile Drawer (Left) */
.mobile-drawer {
    left: 0;
    transform: translateX(-100%);
}

.mobile-drawer.open {
    transform: translateX(0);
}

.mobile-menu-links {
    padding: 40px;
}

.mobile-menu-links li {
    margin-bottom: 25px;
}

.mobile-link {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 1px;
}

.mobile-link:hover {
    color: var(--color-accent);
    padding-left: 10px;
}

/* Cart Drawer (Right) */
.cart-drawer {
    right: 0;
    transform: translateX(100%);
}

.cart-drawer.open {
    transform: translateX(0);
}

.cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-smooth);
}

.cart-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
}

.cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
}

.empty-cart-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
}

.empty-icon {
    font-size: 3rem;
    color: var(--color-border);
    margin-bottom: 20px;
}

.empty-cart-state p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 30px;
}

.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.cart-item {
    display: flex;
    gap: 20px;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 20px;
}

.cart-item-img {
    width: 90px;
    height: 120px;
    object-fit: cover;
}

.cart-item-details {
    flex: 1;
}

.cart-item-details h4 {
    font-size: 0.95rem;
    margin-bottom: 5px;
    color: var(--color-text-dark);
}

.cart-item-variant {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 10px;
}

.cart-item-price {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
}

.cart-item-qty {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 10px;
}

.qty-btn {
    background: none;
    border: 1px solid var(--color-border);
    width: 25px;
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.8rem;
    transition: var(--transition-fast);
}

.qty-btn:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-secondary);
}

.qty-val {
    font-size: 0.85rem;
    font-weight: 500;
}

.cart-item-remove {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.8rem;
    margin-top: 10px;
    display: block;
    text-decoration: underline;
}

.cart-item-remove:hover {
    color: #ff3b30;
}

.cart-footer {
    padding: 30px 40px;
    border-top: 1px solid var(--color-border);
    background-color: #fcfbfa;
}

.cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 10px;
}

.subtotal-amount {
    color: var(--color-accent);
}

.shipping-tax-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 25px;
}

.btn-checkout {
    width: 100%;
}

/* Fullscreen Search Overlay */
.search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(15px);
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-smooth);
}

.search-overlay.open {
    opacity: 1;
    visibility: visible;
}

.search-close {
    position: absolute;
    top: 40px;
    right: 50px;
    background: none;
    border: none;
    font-size: 3rem;
    font-weight: 200;
    cursor: pointer;
    transition: var(--transition-fast);
}

.search-close:hover {
    color: var(--color-accent);
}

.search-overlay-content {
    width: 100%;
    max-width: 800px;
    padding: 0 40px;
    text-align: center;
}

.search-heading {
    font-size: 1.8rem;
    margin-bottom: 30px;
    font-weight: 400;
}

.search-form {
    position: relative;
    border-bottom: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    padding-bottom: 10px;
}

.search-input {
    width: 100%;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 300;
    padding-right: 50px;
}

.search-submit-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: var(--color-primary);
    transition: var(--transition-fast);
}

.search-submit-btn:hover {
    transform: translateX(5px);
    color: var(--color-accent);
}

.search-suggestions {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.suggestion-tag {
    background-color: var(--color-border);
    padding: 8px 18px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-fast);
}

.suggestion-tag:hover {
    background-color: var(--color-primary);
    color: var(--color-secondary);
}

/* Hero Section */
.hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    text-align: center;
    overflow: hidden;
}

.hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: zoomOut 20s infinite alternate;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.6) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 40px;
    margin-top: 50px;
}

.hero-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 20px;
    animation: fadeInUp 1s ease forwards;
}

.hero-title {
    font-size: 4.5rem;
    line-height: 1.1;
    margin-bottom: 25px;
    animation: fadeInUp 1.2s ease forwards;
}

.hero-description {
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    margin-bottom: 40px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 1.4s ease forwards;
}

.hero-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    animation: fadeInUp 1.6s ease forwards;
}

@media (max-width: 768px) {
    .hero-title {
        font-size: 2.8rem;
    }
    .hero-description {
        font-size: 0.95rem;
    }
    .hero-actions {
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }
    .hero-actions .btn {
        width: 100%;
        max-width: 300px;
    }
}

.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.scroll-text {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
}

.scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%);
    animation: pulseScroll 2s infinite;
}

@keyframes zoomOut {
    0% { transform: scale(1.08); }
    100% { transform: scale(1); }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulseScroll {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
}

/* Brand Pitch */
.brand-pitch {
    padding: 100px 0;
    background-color: var(--color-secondary);
}

.section-title-alt {
    font-size: 2.2rem;
    margin-bottom: 60px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.pitch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
}

@media (max-width: 991px) {
    .pitch-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

.pitch-card {
    padding: 20px;
}

.pitch-icon {
    font-size: 2rem;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.pitch-card h3 {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.pitch-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 300;
}

/* Collections Section */
.collections-section {
    padding: 100px 0;
}

.section-title {
    font-size: 2.2rem;
    margin-bottom: 40px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

@media (max-width: 991px) {
    .collections-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }
}

.collection-card {
    position: relative;
    height: 550px;
    overflow: hidden;
    cursor: pointer;
}

.collection-img-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.collection-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
}

.collection-card:hover .collection-img {
    transform: scale(1.05);
}

.collection-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 40px;
    background: linear-gradient(360deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    color: var(--color-secondary);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

.collection-content h3 {
    font-size: 1.6rem;
    margin-bottom: 10px;
}

.collection-link {
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
}

.collection-link i {
    margin-left: 5px;
    transition: var(--transition-fast);
}

.collection-card:hover .collection-link i {
    transform: translateX(5px);
}

/* Products Section */
.products-section {
    padding: 100px 0;
    background-color: var(--color-secondary);
}

.section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 50px;
}

@media (max-width: 768px) {
    .section-header-flex {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }
}

.product-filters {
    display: flex;
    gap: 30px;
}

.filter-tab {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-muted);
    cursor: pointer;
    padding-bottom: 5px;
    border-bottom: 1px solid transparent;
    transition: var(--transition-fast);
}

.filter-tab.active, .filter-tab:hover {
    color: var(--color-primary);
    border-color: var(--color-accent);
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 30px;
}

@media (max-width: 991px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .products-grid {
        grid-template-columns: 1fr;
    }
}

.product-card {
    position: relative;
    display: flex;
    flex-direction: column;
}

.product-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 5px 12px;
    z-index: 10;
}

.product-img-wrapper {
    position: relative;
    height: 480px;
    overflow: hidden;
    background-color: #f7f7f7;
    margin-bottom: 20px;
}

.product-primary-img, .product-secondary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
}

.product-secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
}

.product-card:hover .product-secondary-img {
    opacity: 1;
}

.product-card:hover .product-primary-img {
    transform: scale(1.03);
}

.product-hover-actions {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    display: flex;
    gap: 1px;
    transition: var(--transition-smooth);
    opacity: 0;
    z-index: 10;
}

.product-card:hover .product-hover-actions {
    bottom: 0;
    opacity: 1;
}

.product-hover-btn {
    flex: 1;
    background-color: var(--color-primary);
    color: var(--color-secondary);
    border: none;
    padding: 15px 0;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: var(--transition-fast);
}

.product-hover-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-primary);
}

.product-info {
    text-align: center;
}

.product-title {
    font-size: 1.15rem;
    margin-bottom: 8px;
    font-weight: 400;
}

.product-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

/* Promo Banner */
.promo-banner {
    position: relative;
    padding: 180px 0;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    color: var(--color-secondary);
    text-align: center;
}

.promo-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.65);
}

.promo-content {
    position: relative;
    z-index: 10;
    max-width: 800px;
    margin: 0 auto;
}

.promo-content h2 {
    font-size: 3rem;
    margin-bottom: 20px;
}

.promo-content p {
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 40px;
}

@media (max-width: 768px) {
    .promo-content h2 {
        font-size: 2.2rem;
    }
    .promo-content p {
        font-size: 0.95rem;
    }
}

/* Newsletter Section */
.newsletter-section {
    padding: 100px 0;
    background-color: #f3effa; /* subtle purplish cream tint for elegant contrast */
}

.newsletter-section h2 {
    font-size: 2.2rem;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.newsletter-section p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.newsletter-form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-primary);
}

.newsletter-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    padding: 15px;
    font-family: var(--font-body);
    font-size: 0.9rem;
}

.newsletter-form .btn {
    padding: 15px 30px;
}

/* Quick View Modal styling */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
    z-index: 2001;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-smooth);
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;
}

.quick-view-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 900px;
    max-width: 90%;
    max-height: 90vh;
    background-color: var(--color-secondary);
    z-index: 2002;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    transition: var(--transition-smooth);
    overflow-y: auto;
}

.quick-view-modal.open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    font-weight: 300;
    z-index: 10;
}

.modal-close:hover {
    color: var(--color-accent);
}

.modal-body {
    padding: 50px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

@media (max-width: 768px) {
    .modal-body {
        grid-template-columns: 1fr;
        padding: 30px 20px;
    }
}

.modal-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 500px;
}

.modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.modal-info-col h3 {
    font-size: 2rem;
    margin-bottom: 10px;
}

.modal-price {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 20px;
}

.modal-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 30px;
}

.modal-options-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.modal-options-grid {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
}

.option-select {
    padding: 10px 15px;
    border: 1px solid var(--color-border);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    transition: var(--transition-fast);
}

.option-select.active, .option-select:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-secondary);
}

.modal-qty-container {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.modal-qty-container .qty-btn {
    width: 35px;
    height: 35px;
}

.modal-qty-container .qty-val {
    font-size: 1rem;
}

/* Footer Section */
footer {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    padding: 80px 0 30px 0;
    border-top: 1px solid #1f1f1f;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 50px;
    margin-bottom: 60px;
}

@media (max-width: 991px) {
    .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
}

@media (max-width: 576px) {
    .footer-grid {
        grid-template-columns: 1fr;
    }
}

.brand-col h3 {
    font-size: 1.8rem;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.brand-mission {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    margin-bottom: 25px;
    max-width: 350px;
}

.social-links {
    display: flex;
    gap: 20px;
}

.social-links a {
    color: rgba(255,255,255,0.7);
    font-size: 1.15rem;
    transition: var(--transition-fast);
}

.social-links a:hover {
    color: var(--color-accent);
}

.footer-col h4 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 25px;
    color: var(--color-accent);
}

.footer-col ul li {
    margin-bottom: 15px;
}

.footer-col ul li a {
    color: rgba(255,255,255,0.7);
    font-size: 0.85rem;
}

.footer-col ul li a:hover {
    color: var(--color-secondary);
    padding-left: 5px;
}

.footer-bottom {
    border-top: 1px solid #1f1f1f;
    padding-top: 30px;
}

.bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
}

@media (max-width: 768px) {
    .bottom-flex {
        flex-direction: column;
        gap: 20px;
        text-align: center;
    }
}

.payment-methods {
    display: flex;
    gap: 15px;
    font-size: 1.5rem;
}

.payment-methods i {
    color: rgba(255,255,255,0.6);
}
