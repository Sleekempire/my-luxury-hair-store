    padding-bottom: 8px;
    border-bottom: 1.5px solid transparent;
    transition: var(--transition-standard);
}

.filter-tab.active, .filter-tab:hover {
    color: var(--color-secondary);
    border-color: var(--color-accent);
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px 40px;
}

@media (max-width: 1024px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px 20px;
    }
    
    .product-img-wrapper {
        height: 380px;
    }
}

@media (max-width: 768px) {
    .product-hover-actions {
        position: relative;
        bottom: 0 !important;
        opacity: 1 !important;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }
    
    .product-hover-btn {
        padding: 14px 0;
        font-size: 0.65rem;
    }
}

@media (max-width: 576px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px 12px;
    }
    
    .product-img-wrapper {
        height: 240px;
    }
    
    .product-info {
        padding: 15px;
    }
    
    .product-title {
        font-size: 0.95rem;
        margin-bottom: 6px;
    }
    
    .product-price {
        font-size: 0.85rem;
    }
}

.product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: var(--transition-luxury);
    border-radius: 4px;
    overflow: hidden;
}

.product-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(197, 168, 128, 0.1);
    transform: translateY(-5px);
}

.product-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 6px 16px;
    z-index: 10;
}

.product-img-wrapper {
    position: relative;
    height: 520px;
    overflow: hidden;
    background-color: var(--color-primary);
}

.product-img-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.25) 50%, 
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    transition: 0.75s;
    z-index: 5;
}

.product-card:hover .product-img-wrapper::after {
    left: 150%;
}

.product-primary-img, .product-secondary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
}

.product-card:hover .product-secondary-img {
    opacity: 0.9;
    transform: scale(1.04);
}

.product-card:hover .product-primary-img {
    transform: scale(1.04);
}

/* Sleek Quick buy bottom overlay */
.product-hover-actions {
    position: absolute;
    bottom: -60px;
    left: 0;
    width: 100%;
    display: flex;
    gap: 1px;
    transition: var(--transition-luxury);
    opacity: 0;
    z-index: 10;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(10px);
}

.product-card:hover .product-hover-actions {
    bottom: 0;
    opacity: 1;
}

.product-hover-btn {
    flex: 1;
    background: linear-gradient(135deg, #f5dcd6 0%, #D5A79E 50%, #b27c72 100%);
    color: var(--color-primary);
    border: none;
    padding: 18px 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    transition: var(--transition-standard);
    cursor: pointer;
}

.product-hover-btn:hover {
    background-color: var(--color-secondary);
    color: var(--color-primary);
}

.product-info {
    text-align: left;
    padding: 25px;
}

.product-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 12px;
    font-weight: 400;
    color: var(--color-secondary);
}

.product-price {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
}

/* Premium Promo Section */
.promo-banner {
    position: relative;
    padding: 240px 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: #ffffff;
    text-align: center;
    overflow: hidden;
}

.promo-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.78);
}

.promo-content {
    position: relative;
    z-index: 10;
    max-width: 850px;
    margin: 0 auto;
}

.promo-content h2 {
    font-size: 3.5rem;
    margin-bottom: 25px;
    font-weight: 300;
    letter-spacing: 0.02em;
}

.promo-content p {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 45px;
}

@media (max-width: 768px) {
    .promo-content h2 {
        font-size: 2.5rem;
    }
    .promo-content p {
        font-size: 1rem;
    }
}

/* Elite Newsletter Form */
.newsletter-section {
    padding: 140px 0;
    background-color: var(--color-bg-dark);
}

.newsletter-section h2 {
    font-size: 2.6rem;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
}

.newsletter-section p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 50px;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.8;
}

.newsletter-form {
    display: flex;
    max-width: 700px;
    margin: 0 auto;
    border-bottom: 1.5px solid var(--color-accent);
}

.newsletter-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    padding: 18px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-secondary);
}

.newsletter-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
}

.newsletter-form .btn {
    padding: 18px 45px;
}

/* Elite Quick View Modal styling */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    z-index: 2001;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-luxury);
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;
}

.quick-view-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: 1000px;
    max-width: 90%;
    max-height: 90vh;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-thin);
    z-index: 2002;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    transition: var(--transition-luxury);
    overflow-y: auto;
}

.quick-view-modal.open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.modal-close {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 2.2rem;
    font-weight: 200;
    z-index: 10;
    line-height: 1;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.modal-close:hover {
    color: var(--color-accent);
}

.modal-body {
    padding: 60px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
}

@media (max-width: 991px) {
    .modal-body {
        grid-template-columns: 1fr;
        padding: 50px 30px;
        gap: 40px;
    }
}

.modal-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 550px;
}

.modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.modal-info-col h3 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    margin-bottom: 12px;
}

.modal-price {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 25px;
}

.modal-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 35px;
}

.modal-options-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 15px;
    color: var(--color-text-light);
}

.modal-options-grid {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
}

.option-select {
    border: 1px solid var(--color-border-thin);
    padding: 12px 20px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    transition: var(--transition-standard);
}

.option-select.active, .option-select:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-primary);
}

.modal-qty-container {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-bottom: 35px;
}

.modal-qty-container .qty-btn {
    width: 32px;
    height: 32px;
}

.modal-qty-container .qty-val {
    font-size: 0.95rem;
}

/* Elite Footer Layout */
footer {
    background-color: var(--color-secondary); /* Deep Velvet Emerald Green */
    color: #ffffff;
    padding: 100px 0 40px 0;
    border-top: 1px solid var(--color-border-thin);
}

.footer-grid {
