    position: relative;
}

.spotlight-img-frame {
    width: 100%;
    overflow: hidden;
    background-color: var(--color-primary);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    position: relative;
}

.spotlight-img-frame::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.25) 50%, 
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    transition: 0.75s;
    z-index: 5;
}

.spotlight-grid:hover .spotlight-img-frame::after {
    left: 150%;
}

.spotlight-img {
    width: 100%;
    height: auto;
    object-fit: cover;
}

.spotlight-features-list {
    margin: 30px 0;
}

.spotlight-features-list li {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.spotlight-features-list li i {
    color: var(--color-accent);
    font-size: 0.85rem;
}

.spotlight-price-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
}

.spotlight-price {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--color-accent);
}

.spotlight-original-price {
    font-size: 1.2rem;
    text-decoration: line-through;
    color: var(--color-text-muted);
}

.spotlight-buy-actions {
    display: flex;
    gap: 20px;
}

.spotlight-buy-actions .btn {
    flex: 1;
    text-align: center;
}

/* Reviews Testimonials Section */
.reviews-section {
    padding: 140px 0;
    background-color: var(--color-bg-dark);
}

.reviews-carousel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 50px;
}

.review-card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 40px;
    text-align: left;
    transition: var(--transition-luxury);
    border-radius: 4px;
}

.review-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(197, 168, 128, 0.15);
    transform: translateY(-5px);
}

.review-rating {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin-bottom: 25px;
}

.review-comment {
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: 30px;
    font-style: italic;
}

.reviewer-name {
    display: block;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-secondary);
}

.reviewer-status {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 3px;
    display: inline-block;
}

/* Responsiveness overrides for the new sections */
@media (max-width: 991px) {
    .founder-grid, .spotlight-grid {
        grid-template-columns: 1fr;
        gap: 50px;
    }
    .spotlight-grid .spotlight-img-col {
        order: -1; /* Place image on top on mobile */
    }
    .reviews-carousel {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    .founder-section, .spotlight-section, .reviews-section {
        padding: 80px 0;
    }
}

@media (max-width: 576px) {
    .editorial-title {
        font-size: 2rem !important;
    }
    .spotlight-buy-actions {
        flex-direction: column;
        gap: 15px;
    }
    .review-card {
        padding: 30px;
    }
}

/* ==========================================================================
   DESIGN SWITCHER WIDGET & 5 CUSTOM STOREFRONT LAYOUT STYLES
   ========================================================================== */

/* Design Layout wrappers display toggling */
.design-layout-wrapper {
    display: none;
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.design-layout-wrapper.active {
    display: block;
}



/* --------------------------------------------------------------------------
   DESIGN 2: MINIMALIST MODERN GRID OVERRIDES
   -------------------------------------------------------------------------- */
.design-mode-2 {
    --color-border-thin: rgba(46, 26, 34, 0.08);
}

.split-hero-section {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    min-height: 90vh;
    background-color: var(--color-bg-dark);
}

.split-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.split-hero-text {
    display: flex;
    align-items: center;
    padding: 80px;
    background-color: var(--color-primary);
}

.split-hero-text-content {
    max-width: 420px;
}

.minimal-label {
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: var(--color-accent);
}

.minimal-title {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 300;
    line-height: 1.2;
    margin: 20px 0;
}

.minimal-desc {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 40px;
}

.btn-dark-minimal {
    display: inline-block;
    padding: 16px 35px;
    background-color: var(--color-secondary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border: none;
}

.btn-dark-minimal:hover {
    background-color: var(--color-accent);
    color: var(--color-primary);
}

/* Asymmetrical Card layout */
.asym-collections-section {
    padding: 120px 0;
}

.asym-row-1 {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 40px;
}

.asym-card {
    position: relative;
    height: 520px;
    overflow: hidden;
}

.asym-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-luxury);
}

.asym-card:hover img {
    transform: scale(1.05);
}

.asym-overlay-content {
    position: absolute;
    bottom: 50px;
    left: 50px;
    z-index: 10;
}

.asym-overlay-content h3 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 15px;
}

.asym-overlay-content a {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
}

.minimal-section-header {
    margin-bottom: 80px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}

.minimal-section-header h2 {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 300;
}

/* Asymmetrical Product Masonry Grid */
.grid-asym {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
}

.grid-asym .product-card:nth-child(2) {
    transform: translateY(60px);
}

.values-divider-section {
    padding: 100px 0;
    border-top: 1px solid var(--color-border-thin);
    border-bottom: 1px solid var(--color-border-thin);
}

.values-flex-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
}

.value-item span {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: var(--color-accent);
    font-weight: 300;
    display: block;
    margin-bottom: 15px;
}

.value-item h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 15px;
}

.value-item p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
}

.editorial-quote-banner {
    padding: 160px 0;
    background-color: var(--color-bg-dark);
}

.editorial-quote-banner blockquote {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-style: italic;
    font-weight: 300;
    max-width: 900px;
    margin: 0 auto 30px auto;
    line-height: 1.5;
}

.editorial-quote-banner cite {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    font-weight: 700;
}

.minimal-newsletter-section {
    padding: 120px 0;
}

.minimal-newsletter-section h3 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 40px;
}

.minimal-newsletter-form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-secondary);
    padding-bottom: 15px;
}

.minimal-newsletter-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-size: 1.2rem;
    color: var(--color-secondary);
}

.minimal-newsletter-btn {
    background: none;
    border: none;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    color: var(--color-secondary);
}

@media (max-width: 991px) {
    .split-hero-section {
        grid-template-columns: 1fr;
    }
    .asym-row-1 {
        grid-template-columns: 1fr;
    }
    .asym-card {
        height: 380px;
    }
    .grid-asym {
        grid-template-columns: 1fr;
    }
    .grid-asym .product-card:nth-child(2) {
        transform: none;
    }
    .values-flex-row {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

/* --------------------------------------------------------------------------
   DESIGN 3: COUTURE BOUTIQUE OVERRIDES
   -------------------------------------------------------------------------- */
.couture-hero {
    position: relative;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.couture-hero-bg {
    position: absolute;
