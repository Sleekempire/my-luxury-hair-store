<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }} | {{ shop.name }}</title>
    
    {% if page_description %}
        <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Cinzel:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Shopify Required Header Elements -->
    {{ content_for_header }}
    
    <!-- Theme CSS Asset -->
    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}&v=3" type="text/css" media="all">
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement-bar">
        <p>EXPRESS WORLDWIDE TRACKED SHIPPING &bull; COMPLIMENTARY BOX WITH ALL WIG ORDERS</p>
    </div>

    <!-- Header Navigation -->
    <header id="main-header" class="header-transparent">
        <div class="header-container">
            <!-- Mobile Menu Toggle -->
            <button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle Navigation">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>

            <!-- Navigation Links Left -->
            <nav class="desktop-nav nav-left">
                <ul>
                    <li><a href="#featured-products" class="nav-link active">Shop</a></li>
                    <li><a href="#footer" class="nav-link">Our Story</a></li>
                    <li><a href="#footer" class="nav-link">FAQ</a></li>
                </ul>
            </nav>

            <!-- Centered Logo -->
            <div class="logo-container">
                <a href="/" class="logo-text" style="text-transform: lowercase; font-family: 'Playfair Display', serif;">muyigreenhair</a>
            </div>

            <!-- Navigation Links Right / Utilities -->
            <div class="header-utilities">
                <span class="currency-picker" style="font-size: 0.75rem; letter-spacing: 0.1em; font-weight: 500; margin-right: 15px; cursor: pointer;">GBP £ <i class="fa-solid fa-chevron-down" style="font-size: 0.55rem; margin-left: 2px;"></i></span>
                <button class="utility-btn" id="search-trigger" aria-label="Search Store">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <a href="javascript:void(0)" class="utility-btn" id="account-link" aria-label="Account">
                    <i class="fa-regular fa-user"></i>
                </a>
                <button class="utility-btn" id="cart-trigger" aria-label="Shopping Cart">
                    <i class="fa-solid fa-bag-shopping"></i> (<span id="cart-badge-count">0</span>)
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Nav Overlay Drawer -->
    <div class="mobile-drawer-overlay" id="mobile-drawer-overlay"></div>
    <div class="mobile-drawer" id="mobile-drawer">
        <div class="drawer-header">
            <span class="drawer-title">MENU</span>
            <button class="drawer-close" id="mobile-drawer-close">&times;</button>
        </div>
        <nav class="mobile-menu-links">
            <ul>
                <li><a href="/" class="mobile-link">Home</a></li>
                <li><a href="#featured-products" class="mobile-link">Shop Wigs</a></li>
                <li><a href="#collections" class="mobile-link">Bundles</a></li>
                <li><a href="#collections" class="mobile-link">Closures & Frontals</a></li>
                <li><a href="#footer" class="mobile-link">About Us</a></li>
                <li><a href="#footer" class="mobile-link">Contact</a></li>
            </ul>
        </nav>
    </div>

    <!-- Fullscreen Search Overlay -->
    <div class="search-overlay" id="search-overlay">
        <button class="search-close" id="search-close-btn">&times;</button>
        <div class="search-overlay-content">
            <h3 class="search-heading">What are you looking for?</h3>
            <form class="search-form" onsubmit="event.preventDefault();">
                <input type="text" placeholder="Search for wigs, bundles, closures..." class="search-input" id="search-input-field" autocomplete="off">
                <button type="submit" class="search-submit-btn"><i class="fa-solid fa-arrow-right-long"></i></button>
            </form>
            <div class="search-suggestions">
                <span class="suggestion-tag">Body Wave Wig</span>
                <span class="suggestion-tag">Virgin Straight Bundles</span>
                <span class="suggestion-tag">HD Lace Frontals</span>
                <span class="suggestion-tag">Glueless Wigs</span>
            </div>
        </div>
    </div>

    <!-- Cart Sidebar Drawer -->
    <div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
    <div class="cart-drawer" id="cart-drawer">
        <div class="drawer-header">
            <span class="drawer-title">YOUR BAG (<span id="cart-drawer-count">0</span>)</span>
            <button class="drawer-close" id="cart-drawer-close">&times;</button>
        </div>
        <div class="cart-items-container" id="cart-items-container">
            <!-- Empty Cart State -->
            <div class="empty-cart-state" id="empty-cart-state">
                <i class="fa-solid fa-bag-shopping empty-icon"></i>
                <p>Your bag is currently empty.</p>
                <button class="btn btn-gold btn-shop-now" id="cart-shop-now-btn">Shop Our Collection</button>
            </div>
            <!-- Cart Items List will be injected here by app.js -->
            <div class="cart-items-list" id="cart-items-list" style="display: none;"></div>
        </div>
        <div class="cart-footer" id="cart-footer" style="display: none;">
            <div class="cart-subtotal-row">
                <span>Subtotal</span>
                <span class="subtotal-amount" id="cart-subtotal-value">$0.00</span>
            </div>
            <p class="shipping-tax-note">Shipping & taxes calculated at checkout</p>
            <button class="btn btn-gold btn-checkout" id="checkout-button">Proceed to Checkout</button>
        </div>
    </div>

    <!-- Quick View Modal -->
    <div class="modal-overlay" id="quick-view-overlay"></div>
    <div class="quick-view-modal" id="quick-view-modal">
        <button class="modal-close" id="quick-view-close">&times;</button>
        <div class="modal-body" id="quick-view-body">
            <!-- Content populated by JavaScript -->
        </div>
    </div>

    <!-- Dynamic Shopify Page Content Injection -->
    <main>
        {{ content_for_layout }}
    </main>

    <!-- Footer -->
    <footer id="footer" style="background-color:#ffffff; color:#000000; padding:80px 0 40px 0; border-top:1px solid #eaeaea;">
        <div class="container footer-grid" style="display:grid; grid-template-columns: repeat(3, 1fr); gap:40px; margin-bottom:60px;">
            <div class="footer-col">
                <h4 style="font-size:0.75rem; text-transform:none; font-weight:700; margin-bottom:20px; color:#000000; font-family:'Inter',sans-serif;">About</h4>
                <ul style="list-style:none; padding:0; margin:0;">
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Our story</a></li>
                    <li style="margin-bottom:12px;"><a href="mailto:support@muyigreenhair.com" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Contact us</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4 style="font-size:0.75rem; text-transform:none; font-weight:700; margin-bottom:20px; color:#000000; font-family:'Inter',sans-serif;">Customer Care</h4>
                <ul style="list-style:none; padding:0; margin:0;">
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">FAQ</a></li>
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Care instructions</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4 style="font-size:0.75rem; text-transform:none; font-weight:700; margin-bottom:20px; color:#000000; font-family:'Inter',sans-serif;">Legal</h4>
                <ul style="list-style:none; padding:0; margin:0;">
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Privacy policy</a></li>
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Terms of service</a></li>
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Refund policy</a></li>
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Contact information</a></li>
                    <li style="margin-bottom:12px;"><a href="javascript:void(0)" style="font-size:0.75rem; color:#111111; font-family:'Inter',sans-serif; text-decoration:none;">Cookie preferences</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom" style="border-top:1px solid #eaeaea; padding-top:25px;">
            <div class="container bottom-flex" style="display:flex; justify-content:space-between; align-items:center; font-size:0.75rem; color:#777777; font-family:'Inter',sans-serif;">
                <p>&copy; {{ 'now' | date: "%Y" }} muyigreenhair</p>
                <div class="footer-instagram-link">
                    <a href="https://instagram.com" target="_blank" style="color:#777777; text-decoration:none;">Instagram</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Theme JS Asset -->
    <script src="{{ 'app.js' | asset_url }}&v=3" defer></script>

</body>
</html>
